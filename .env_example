# JWT Token Configuration
TOKEN_SECRET_KEY=your-super-secret-jwt-key-here-make-it-long-and-random
TOKEN_ALGORITHM=HS256
TOKEN_ACCESS_TOKEN_EXPIRE_MINUTES=15
TOKEN_REFRESH_TOKEN_EXPIRE_DAYS=30

# Database settings
DB_DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/education_platform

# Sentry url
LOGGING_SENTRY_URL=https://your-sentry-dsn-here.sentry.io/project-id

# Stripe Payment Configuration
STRIPE_SECRET_KEY=sk_your_stripe_secret_key_here

# Payment Provider Configuration
# Available options: stripe, paypal, liqpay, wayforpay
PAYMENT_PROVIDER=stripe

# Application Log Level
LOG_LEVEL=INFO
